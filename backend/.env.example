# Kosongkan DATABASE_URL saat pengembangan lokal agar otomatis memakai PGlite lokal di backend/data/pgdata
# Untuk produksi di Vercel, isi dari tab Storage -> Neon Postgres
DATABASE_URL=

# Wajib diisi string acak minimal 32 karakter saat NODE_ENV=production
JWT_SECRET=dev-only-stok-bledek-secret-change-in-production-32chars

# Daftar origin frontend yang diizinkan (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:5173

# Port server lokal (diabaikan di Vercel serverless)
PORT=3000
NODE_ENV=development
